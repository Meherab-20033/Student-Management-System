<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="Chatform" prefHeight="639.0" prefWidth="838.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.studentmangementsystem.AdminChatController">
   <children>
      <AnchorPane layoutX="14.0" layoutY="14.0" prefHeight="614.0" prefWidth="305.0" stylesheets="@dashboard.css">
         <styleClass>
            <String fx:value="background-color1" />
            <String fx:value="white-bg" />
            <String fx:value="shadow" />
         </styleClass>
         <children>
            <TextField fx:id="adminChat_search" layoutX="60.0" layoutY="72.0" prefHeight="26.0" prefWidth="206.0" promptText="Search" style="-fx-background-color: #fff;" stylesheets="@dashboard.css">
               <styleClass>
                  <String fx:value="search" />
                  <String fx:value="label-info" />
               </styleClass>
            </TextField>
            <ImageView fitHeight="24.0" fitWidth="17.0" layoutX="244.0" layoutY="77.0" opacity="0.57" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../../im/search.png.jpeg" />
               </image>
            </ImageView>
            <ScrollPane fx:id="adminChart_Scroll" layoutX="63.0" layoutY="98.0" prefHeight="200.0" prefWidth="200.0">
               <content>
                  <AnchorPane fx:id="resultGridPane" prefHeight="200.0" prefWidth="200.0" />
               </content>
            </ScrollPane>
            <Button fx:id="adminChat_SelectedID" contentDisplay="TOP" layoutX="41.0" layoutY="394.0" mnemonicParsing="false" prefHeight="30.0" prefWidth="222.0" style="-fx-text-fill: black;" stylesheets="@dashboard.css" text="SelectedID">
               <styleClass>
                  <String fx:value="white-bg" />
                  <String fx:value="shadow" />
                  <String fx:value="login-btn" />
                  <String fx:value="label-info" />
                  <String fx:value="shadow" />
               </styleClass>
            </Button>
         </children>
      </AnchorPane>
      <AnchorPane layoutX="330.0" layoutY="14.0" prefHeight="614.0" prefWidth="498.0" stylesheets="@dashboard.css">
         <styleClass>
            <String fx:value="background-color1" />
            <String fx:value="white-bg" />
            <String fx:value="shadow" />
         </styleClass>
         <children>
            <TextArea fx:id="adminChat_Textarea" layoutX="20.0" layoutY="25.0" prefHeight="528.0" prefWidth="466.0" stylesheets="@dashboard.css">
               <styleClass>
                  <String fx:value="white-bg" />
                  <String fx:value="shadow" />
               </styleClass>
            </TextArea>
            <Button fx:id="adminChat_send" alignment="CENTER" contentDisplay="CENTER" layoutX="25.0" layoutY="562.0" prefHeight="38.0" prefWidth="117.0" stylesheets="@dashboard.css" text="Send">
               <styleClass>
                  <String fx:value="white-bg" />
                  <String fx:value="shadow" />
                  <String fx:value="login" />
                  <String fx:value="login-btn" />
               </styleClass>
            </Button>
            <ImageView fitHeight="24.0" fitWidth="25.0" layoutX="33.0" layoutY="569.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../../im/send1.png" />
               </image>
            </ImageView>
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
