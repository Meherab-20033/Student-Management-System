            <String fx:value="background-color" />
            <String fx:value="shadow" />
            <String fx:value="white-bg" />
         </styleClass>
         <children>
            <TextField fx:id="StudentInfo_MessageSearch" layoutX="11.0" layoutY="65.0" prefHeight="26.0" prefWidth="206.0" promptText="Search" style="-fx-background-color: #fff;" stylesheets="@dashboard.css">
               <styleClass>
                  <String fx:value="search" />
                  <String fx:value="label-info" />
               </styleClass>
            </TextField>
            <ImageView fitHeight="24.0" fitWidth="17.0" layoutX="195.0" layoutY="70.0" opacity="0.57" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../../im/search.png.jpeg" />
               </image>
            </ImageView>
            <ScrollPane layoutX="14.0" layoutY="91.0" prefHeight="200.0" prefWidth="200.0" styleClass="shadow" stylesheets="@dashboard.css">
               <content>
                  <AnchorPane fx:id="StudentInfo_MessageScrollPane" minHeight="0.0" minWidth="0.0" prefHeight="200.0" prefWidth="200.0" />
               </content>
            </ScrollPane>
            <Label fx:id="StudentInfo_MessageSelectedID" alignment="CENTER" layoutX="25.0" layoutY="355.0" prefHeight="28.0" prefWidth="178.0" style="-fx-text-fill: black;" stylesheets="@dashboard.css" text="Selected ID">
               <styleClass>
                  <String fx:value="white-bg" />
                  <String fx:value="shadow" />
                  <String fx:value="label-info" />
                  <String fx:value="update-btn" />
               </styleClass>
            </Label>
         </children>
      </AnchorPane>
      <AnchorPane layoutX="247.0" layoutY="9.0" prefHeight="560.0" prefWidth="406.0">
         <children>
            <AnchorPane layoutX="7.0" layoutY="9.0" prefHeight="542.0" prefWidth="390.0" stylesheets="@dashboard.css">
               <styleClass>
                  <String fx:value="background-color" />
                  <String fx:value="white-bg" />
                  <String fx:value="shadow" />
               </styleClass>
               <children>
                  <TextArea fx:id="StudentInfo_MessageTextArea" layoutX="10.0" layoutY="14.0" prefHeight="473.0" prefWidth="370.0" stylesheets="@dashboard.css" />
                  <Button fx:id="StudentInfo_MessageSend" layoutX="10.0" layoutY="501.0" mnemonicParsing="false" prefHeight="26.0" prefWidth="179.0" stylesheets="@dashboard.css" text="Send">
                     <styleClass>
                        <String fx:value="background-color" />
                        <String fx:value="update-btn" />
                        <String fx:value="shadow" />
                        <String fx:value="login-btn" />
                     </styleClass>
                  </Button>
                  <ImageView fitHeight="24.0" fitWidth="25.0" layoutX="151.0" layoutY="503.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../../im/send1.png" />
                     </image>
                  </ImageView>
                  <ScrollBar layoutX="365.0" layoutY="14.0" orientation="VERTICAL" prefHeight="473.0" prefWidth="14.0" />
               </children>
            </AnchorPane>
         </children>
      </AnchorPane>
      <Button fx:id="close" layoutX="12.0" layoutY="3.0" mnemonicParsing="false" onAction="#close" prefHeight="26.0" prefWidth="52.0" styleClass="close-btn" stylesheets="@dashboard.css" text="X" />
   </children>
