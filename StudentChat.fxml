<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="StudentInfo_messegeForm" prefHeight="579.0" prefWidth="660.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.studentmangementsystem.StudentChatController">
   <children>
      <AnchorPane layoutX="10.0" layoutY="38.0" prefHeight="528.0" prefWidth="226.0" stylesheets="@dashboard.css">
